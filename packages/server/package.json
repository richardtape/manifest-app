    "@manifest/contract": "link:../../../manifest/packages/contract",
    "fastify": "5.12.3",
    "vite": "8.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@manifest/mock": "link:../../../manifest/packages/mock"
  }
}
